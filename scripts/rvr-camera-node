#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-jazzy}"
RPI_LIBCAMERA_ROOT="${RPI_LIBCAMERA_ROOT:-$HOME/.local/rpi-libcamera}"
RVR_ROS_WS="${RVR_ROS_WS:-$HOME/ros2_ws}"

# shellcheck disable=SC1090
set +u
source "/opt/ros/${ROS_DISTRO}/setup.bash"
set -u
if [[ -f "$RVR_ROS_WS/install/setup.bash" ]]; then
  # shellcheck disable=SC1091
  set +u
  source "$RVR_ROS_WS/install/setup.bash"
  set -u
fi

export PATH="$RPI_LIBCAMERA_ROOT/bin:$PATH"
export LD_LIBRARY_PATH="$RPI_LIBCAMERA_ROOT/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec ros2 run camera_ros camera_node "$@"
