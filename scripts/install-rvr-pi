#!/usr/bin/env bash
set -euo pipefail

ROS_DISTRO="${ROS_DISTRO:-jazzy}"
PACKAGE_NAME="sphero_rvr_driver"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

if [[ -n "${RVR_ROS_WS:-}" ]]; then
  WS_ROOT="$RVR_ROS_WS"
elif [[ "$(basename "$(dirname "$REPO_ROOT")")" == "src" ]]; then
  WS_ROOT="$(cd -- "$REPO_ROOT/../.." && pwd)"
else
  WS_ROOT="$HOME/ros2_ws"
fi

export DEBIAN_FRONTEND=noninteractive

log() {
  printf '\n==> %s\n' "$*"
}

source_ros_setup() {
  # ROS setup scripts reference unset variables under some shells; keep this
  # installer strict everywhere else, but do not let `set -u` break sourcing.
  set +u
  # shellcheck disable=SC1090
  source "$1"
  set -u
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1
}

if ! need_cmd sudo; then
  echo "sudo is required for apt/udev setup" >&2
  exit 1
fi

log "Installing Ubuntu base tools"
sudo apt-get update
sudo apt-get install -y \
  locales \
  software-properties-common \
  curl \
  gnupg \
  lsb-release \
  git \
  python3-pip \
  python3-venv

sudo locale-gen en_US.UTF-8 >/dev/null || true
sudo update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 || true
sudo add-apt-repository universe -y

if [[ -f /etc/apt/sources.list.d/ubuntu.sources ]] && ! grep -q 'noble-updates' /etc/apt/sources.list.d/ubuntu.sources; then
  log "Adding noble-updates/noble-backports to Ubuntu apt source"
  sudo cp /etc/apt/sources.list.d/ubuntu.sources "/etc/apt/sources.list.d/ubuntu.sources.bak.$(date +%Y%m%d%H%M%S)"
  sudo python3 - <<'PY'
from pathlib import Path
p = Path('/etc/apt/sources.list.d/ubuntu.sources')
s = p.read_text()
s = s.replace(
    'Suites: noble\nComponents: main restricted universe multiverse',
    'Suites: noble noble-updates noble-backports\nComponents: main restricted universe multiverse',
    1,
)
p.write_text(s)
PY
fi

if [[ ! -f /usr/share/keyrings/ros-archive-keyring.gpg ]]; then
  log "Installing ROS apt key"
  sudo curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg
fi

if [[ ! -f /etc/apt/sources.list.d/ros2.list ]]; then
  log "Adding ROS 2 apt repository"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo "$UBUNTU_CODENAME") main" \
    | sudo tee /etc/apt/sources.list.d/ros2.list >/dev/null
fi

log "Installing ROS, build tools, and mapping dependencies"
sudo apt-get update
sudo apt-get install -y \
  "ros-${ROS_DISTRO}-ros-base" \
  "ros-${ROS_DISTRO}-slam-toolbox" \
  "ros-${ROS_DISTRO}-nav2-map-server" \
  python3-colcon-common-extensions \
  python3-rosdep \
  python3-vcstool \
  python3-argcomplete \
  python3-serial

if ! rosdep db 2>/dev/null | grep -q '^OS NAME:'; then
  log "Initializing rosdep"
  sudo rosdep init 2>/dev/null || true
fi
rosdep update

mkdir -p "$WS_ROOT/src"

if [[ "$REPO_ROOT" != "$WS_ROOT/src/$(basename "$REPO_ROOT")" ]]; then
  log "Using repo at $REPO_ROOT with workspace $WS_ROOT"
fi

if [[ -f "$REPO_ROOT/workspace.repos" ]] && [[ ! -d "$WS_ROOT/src/rplidar_ros" ]]; then
  log "Importing workspace source dependencies"
  vcs import "$WS_ROOT/src" < "$REPO_ROOT/workspace.repos"
else
  log "Workspace source dependencies already present or no workspace.repos found"
fi

log "Installing ROS package dependencies from package.xml files"
source_ros_setup "/opt/ros/${ROS_DISTRO}/setup.bash"
rosdep install --from-paths "$WS_ROOT/src" --ignore-src -r -y

log "Building RPLIDAR and RVR packages"
cd "$WS_ROOT"
if [[ -d "$WS_ROOT/src/rplidar_ros" ]]; then
  colcon build --symlink-install --packages-select rplidar_ros "$PACKAGE_NAME"
else
  colcon build --symlink-install --packages-select "$PACKAGE_NAME"
fi

log "Installing device udev rules when available"
if [[ -f "$REPO_ROOT/docs/udev/99-rplidar.rules" ]]; then
  sudo cp "$REPO_ROOT/docs/udev/99-rplidar.rules" /etc/udev/rules.d/
fi
printf 'KERNEL=="ttyAMA0", GROUP="dialout", MODE="0660"\n' \
  | sudo tee /etc/udev/rules.d/99-rvr-uart.rules >/dev/null
sudo systemctl disable --now serial-getty@ttyAMA0.service 2>/dev/null || true
sudo udevadm control --reload-rules || true
sudo udevadm trigger /dev/ttyUSB0 2>/dev/null || true
sudo udevadm trigger /dev/ttyAMA0 2>/dev/null || true
sudo usermod -aG dialout "$USER" || true

log "Verifying install"
source_ros_setup "$WS_ROOT/install/setup.bash"
ros2 pkg prefix "$PACKAGE_NAME"
ros2 pkg prefix slam_toolbox
ros2 pkg prefix nav2_map_server
ros2 run nav2_map_server map_saver_cli --help >/dev/null
ros2 launch "$PACKAGE_NAME" lidar.launch.py --show-args >/dev/null
ros2 launch "$PACKAGE_NAME" mapping.launch.py --show-args >/dev/null

cat <<EOF

Install complete.
Workspace: $WS_ROOT
Package:   $(ros2 pkg prefix "$PACKAGE_NAME")

Open a new shell or run:
  source /opt/ros/${ROS_DISTRO}/setup.bash
  source $WS_ROOT/install/setup.bash

If this user was just added to dialout, log out/in before using /dev/ttyAMA0.
EOF
