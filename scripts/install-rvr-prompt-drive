#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '\n==> %s\n' "$*"
}

if [[ "$(uname -m)" != "aarch64" ]]; then
  echo "This installer is intended for the Raspberry Pi aarch64 runtime." >&2
  exit 2
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "curl is required" >&2
  exit 2
fi

if ! command -v bwrap >/dev/null 2>&1; then
  log "Installing the Linux sandbox prerequisite"
  sudo apt-get update
  sudo apt-get install -y bubblewrap
fi

if ! command -v codex >/dev/null 2>&1 && [[ ! -x "$HOME/.local/bin/codex" ]]; then
  log "Installing the official standalone Codex CLI"
  curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh
fi

export PATH="$HOME/.local/bin:$PATH"
log "Verifying Codex CLI"
codex --version

cat <<'EOF'

Prompt-drive prerequisite installation is complete.

Authenticate this Pi with ChatGPT OAuth using device code:

  codex login --device-auth

Then verify:

  codex login status

The prompt-drive runtime rejects API-key authentication and requires the status
to report: Logged in using ChatGPT
EOF
