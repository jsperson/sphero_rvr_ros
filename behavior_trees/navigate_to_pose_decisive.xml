<!--
  Decisive-controller variant of Nav2's standard
  navigate_to_pose_w_replanning_and_recovery.xml.

  WHY THIS EXISTS: the decisive-controller launch runs our decisive_controller
  node INSTEAD of nav2_controller's controller_server. Nav2's LOCAL costmap lives
  inside controller_server, so in decisive mode there is no local costmap and no
  `local_costmap/clear_entirely_local_costmap` service. The stock BT calls that
  service in two recovery branches, so bt_navigator fails to load the tree and
  never activates (every goal is then rejected).

  This tree is byte-for-byte the stock tree EXCEPT the two local-costmap clears
  are retargeted to the GLOBAL costmap (owned by planner_server, which is always
  up). Everything else — replanning at 1 Hz, retries, spin/wait/backup recovery —
  is unchanged. The decisive controller handles the common "boxed in" case inside
  FollowPath, before these BT recoveries ever fire: it steers away from what is in
  its corridor, and escalates through the stall survival ladder when that is not
  enough (docs/stall_survival_ladder.md, docs/turning_batch_design.md).

  This paragraph used to credit "the decisive controller's own back-off reflex",
  which was deleted in dbbc8b1. A comment describing a mechanism that no longer
  exists is the cheapest possible lying diagnostic: it sends the next reader
  looking for code that is not there.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-FollowPathContext" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <!-- Order matters. Observed 2026-08-06: wedged on a chair leg, Spin was
               tried first, the collision checker aborted it ("Collision Ahead -
               Exiting Spin"), Wait did nothing, and the goal failed before BackUp
               was ever reached. Backing up is both the most likely to succeed (the
               rover just came from there) and the only action that creates room for
               the others, so it now runs first among the motion recoveries. Spin
               follows once there is space; Wait is last, since waiting does not
               help a stuck robot. -->
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <BackUp backup_dist="0.30" backup_speed="0.15" error_code_id="{backup_code_id}"/>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <Wait wait_duration="5.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
