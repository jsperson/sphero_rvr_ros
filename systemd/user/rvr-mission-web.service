[Unit]
Description=Sphero RVR loopback mission web console
After=rvr-mission-service.service
Requires=rvr-mission-service.service

[Service]
Type=simple
EnvironmentFile=%h/.config/sphero_rvr/mission-stack.env
ExecStartPre=/bin/bash -lc 'for attempt in {1..100}; do if [[ -S "$HOME/.local/state/sphero_rvr/mission-service.sock" ]]; then exit 0; fi; sleep 0.1; done; echo "mission service socket did not become ready" >&2; exit 1'
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source "$RVR_ROS_WORKSPACE/install/setup.bash" && exec ros2 run sphero_rvr_driver rvr_mission_web --mode live --host 127.0.0.1 --port "$RVR_WEB_PORT" --mission-socket "$HOME/.local/state/sphero_rvr/mission-service.sock" --session-id rvr-web-console --operator tailscale-serve --public-origin "$RVR_WEB_ORIGIN"'
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
