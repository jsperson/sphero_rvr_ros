# Copy to ~/.config/sphero_rvr/mission-stack.env with mode 0600.
# Both SHAs must be the exact reviewed/deployed commit.
RVR_ROS_WORKSPACE=replace-with-absolute-mission-stack-workspace
RVR_SOURCE_SHA=replace-with-reviewed-source-sha
RVR_DEPLOYED_SHA=replace-with-deployed-source-sha
# Keep false/blank for normal proposal-only hosting. Enabling requires the
# reviewed SHA to exactly match RVR_SOURCE_SHA and RVR_DEPLOYED_SHA; this does not replace the
# operator's later authenticated confirmation of the server-bound proposal digest.
RVR_LIVE_EXECUTION_ENABLED=false
RVR_LIVE_EXECUTION_REVIEWED_SHA=
# Trusted Pi-owned prompt envelope. These conservative values are the
# calibration profile. A reviewed attended-room profile may widen them up to
# 8 calls, 2.0 m cumulative, 0.75 m per call, and 120 s; the model cannot.
RVR_PLANNING_MAX_MOTION_CALLS=3
RVR_PLANNING_MAX_TRANSLATION_M=0.5
RVR_PLANNING_MAX_TRANSLATION_PER_CALL_M=0.5
RVR_PLANNING_MAX_ABS_TURN_DEG=180.0
RVR_PLANNING_MAX_RUNTIME_S=45.0
RVR_PLANNING_LINEAR_SPEED_MPS=0.08
RVR_PLANNING_ANGULAR_SPEED_DEG_S=30.0
RVR_WEB_PORT=8765
RVR_WEB_ORIGIN=https://sphero-pi-2.example-tailnet.ts.net
