# Copy to ~/.config/sphero_rvr/mission-stack.env with mode 0600.
# Both SHAs must be the exact reviewed/deployed commit.
RVR_ROS_WORKSPACE=replace-with-absolute-mission-stack-workspace
RVR_SOURCE_SHA=replace-with-reviewed-source-sha
RVR_DEPLOYED_SHA=replace-with-deployed-source-sha
# Keep false/blank for normal proposal-only hosting. Enabling requires the
# reviewed SHA to exactly match RVR_SOURCE_SHA and RVR_DEPLOYED_SHA; this does not replace the
# operator's later authenticated confirmation of the server-bound proposal digest.
RVR_LIVE_EXECUTION_ENABLED=false
RVR_LIVE_EXECUTION_REVIEWED_SHA=
# Product mode: keep the motor-capable graph stopped until one authenticated
# proposal approval. The reviewed SHA authorizes only this approval-time
# activation path; restart, cancellation, timeout, or any terminal result stops
# the graph again.
RVR_APPROVAL_ACTIVATION_ENABLED=false
RVR_APPROVAL_ACTIVATION_REVIEWED_SHA=
RVR_APPROVAL_ACTIVATION_TIMEOUT_S=30.0
# Whole-mission telemetry and execution lease. Default 15 minutes; values must
# be positive and may not exceed the reviewed 900-second authority ceiling.
RVR_ADAPTIVE_MISSION_LEASE_S=900.0
# Stationary perception only: live lidar/camera perception with the physical gate still false.
RVR_STATIONARY_PERCEPTION_ENABLED=false
# Adaptive mission controller selection is independently default-off. Product
# deployment enables this together with the exact-SHA approval activation gate;
# neither setting starts hardware or grants motion before authenticated approval.
RVR_ADAPTIVE_MISSION_ENABLED=false
RVR_FACE_ENROLLMENT_DIR=/home/jsperson/.local/share/sphero_rvr/face-enrollment
RVR_STATIONARY_EVIDENCE_DIR=/home/jsperson/.local/state/sphero_rvr/stationary-evidence
RVR_STATIONARY_CAMERA_INFO_URL=file:///home/jsperson/.ros/camera_info/rvr_pi_camera3_800x600.yaml
# Trusted Pi-owned prompt envelope. These conservative values are the
# calibration profile. A reviewed attended-room profile may widen them up to
# 8 calls, 2.0 m cumulative, 0.75 m per call, and 120 s; the model cannot.
RVR_PLANNING_MAX_MOTION_CALLS=3
RVR_PLANNING_MAX_TRANSLATION_M=0.5
RVR_PLANNING_MAX_TRANSLATION_PER_CALL_M=0.5
RVR_PLANNING_MAX_ABS_TURN_DEG=180.0
RVR_PLANNING_MAX_RUNTIME_S=45.0
RVR_PLANNING_LINEAR_SPEED_MPS=0.08
RVR_PLANNING_ANGULAR_SPEED_DEG_S=30.0
RVR_WEB_PORT=8765
RVR_WEB_ORIGIN=https://sphero-pi-2.example-tailnet.ts.net
